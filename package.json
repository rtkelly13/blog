{
  "name": "tailwind-nextjs-starter-blog",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "start": "next-remote-watch ./data",
    "dev": "next dev --turbopack",
    "build": "next build && node ./scripts/generate-rss.mjs && node ./scripts/generate-tag-rss.mjs && node ./scripts/generate-sitemap.mjs && node ./scripts/generate-search.mjs && node ./scripts/build-search-index.mjs && node ./scripts/generate-og-images.mjs",
    "og:images": "node ./scripts/generate-og-images.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:watch": "playwright test --reporter=list",
    "test:live-e2e": "node tests/live-e2e.mjs",
    "test:regression": "playwright test --config playwright.regression.config.ts",
    "test:update-snapshots": "playwright test --update-snapshots",
    "test:snapshots:remote": "node scripts/update-snapshots.mjs",
    "post:create": "node scripts/create-post.mjs",
    "post:wizard": "node scripts/compose.mjs",
    "check:seo": "node scripts/audit-seo.mjs",
    "archive-links": "node scripts/archive-links.mjs",
    "check:deploy": "node scripts/verify-deployment.mjs",
    "check:lockfile": "node scripts/ci/check-lockfile-protocol.mjs",
    "search:index": "node scripts/build-search-index.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "provision": "node scripts/provision.mjs",
    "ds:link": "pnpm link ../design-system",
    "ds:unlink": "pnpm unlink @rtkelly13/design-system && pnpm install"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.94",
    "@edge-runtime/vm": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@rtkelly/mermaid-toolkit": "https://codeload.github.com/rtkelly13/mermaid-toolkit/tar.gz/a91c9d35128550180b59a3d576d6e34a61875c58",
    "@rtkelly13/design-system": "^0.0.5",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@ungap/structured-clone": "^1.3.3",
    "@xyflow/react": "^12.11.2",
    "autoprefixer": "^10.5.4",
    "convex": "^1.42.3",
    "convex-test": "^0.0.54",
    "esbuild": "^0.28.1",
    "gray-matter": "^4.0.3",
    "image-size": "2.0.2",
    "katex": "^0.16.47",
    "kbar": "0.1.0-beta.48",
    "lucide-react": "^1.28.0",
    "mdast-util-to-string": "^4.0.0",
    "mdx-bundler": "^10.1.1",
    "mermaid": "^11.16.0",
    "minisearch": "^7.2.0",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "obscenity": "^0.4.6",
    "postcss": "^8.5.25",
    "preact": "^10.29.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-timer-hook": "^4.0.6",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-katex-notranslate": "^1.1.4",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.3",
    "spectacle": "^10.2.3",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@next/bundle-analyzer": "16.2.12",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/unist": "^3.0.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "^4.1.10",
    "cross-env": "^10.1.0",
    "dedent": "^1.7.2",
    "fast-xml-parser": "^5.10.1",
    "globby": "16.2.2",
    "husky": "^9.1.7",
    "inquirer": "^14.0.2",
    "lint-staged": "^17.2.0",
    "next-remote-watch": "^2.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.4.0",
    "storybook": "^10.5.5",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx|json|css)": [
      "biome check --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@playwright/test": "1.61.1",
      "playwright": "1.61.1",
      "playwright-core": "1.61.1",
      "react": "19.2.8",
      "react-dom": "19.2.8"
    }
  }
}
