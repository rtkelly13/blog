{
  "name": "tailwind-nextjs-starter-blog",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "start": "next-remote-watch ./data",
    "dev": "next dev --turbopack",
    "build": "next build && node ./scripts/generate-sitemap.mjs && node ./scripts/generate-search.mjs && node ./scripts/generate-tag-rss.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:watch": "playwright test --reporter=list",
    "test:regression": "playwright test --config playwright.regression.config.ts",
    "test:update-snapshots": "playwright test --update-snapshots",
    "test:snapshots:remote": "node scripts/update-snapshots.mjs",
    "post:create": "node scripts/create-post.mjs",
    "post:wizard": "node scripts/compose.mjs",
    "check:seo": "node scripts/audit-seo.mjs",
    "check:deploy": "node scripts/verify-deployment.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/share-tech-mono": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/vt323": "^5.2.7",
    "@rtkelly/mermaid-toolkit": "github:rtkelly13/mermaid-toolkit#a91c9d3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@ungap/structured-clone": "^1.3.0",
    "autoprefixer": "^10.5.2",
    "convex": "^1.42.0",
    "esbuild": "^0.28.1",
    "gray-matter": "^4.0.3",
    "image-size": "2.0.2",
    "kbar": "0.1.0-beta.48",
    "lucide-react": "^1.22.0",
    "mdast-util-to-string": "^4.0.0",
    "mdx-bundler": "^10.1.1",
    "mermaid": "^11.16.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "obscenity": "^0.4.6",
    "postcss": "^8.5.16",
    "preact": "^10.29.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.2",
    "spectacle": "^10.2.3",
    "tailwindcss": "^4.3.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@chromatic-com/storybook": "^5.2.1",
    "@next/bundle-analyzer": "16.2.9",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-onboarding": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/unist": "^3.0.3",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "^4.1.9",
    "cross-env": "^10.1.0",
    "dedent": "^1.7.2",
    "fast-xml-parser": "^5.9.3",
    "globby": "16.2.0",
    "husky": "^9.1.7",
    "inquirer": "^14.0.2",
    "lint-staged": "^17.0.8",
    "next-remote-watch": "^2.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.1",
    "storybook": "^10.4.6",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx|json|css)": [
      "biome check --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@playwright/test": "1.61.1",
      "playwright": "1.61.1",
      "playwright-core": "1.61.1"
    }
  }
}
